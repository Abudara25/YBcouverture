---
import { webpSrc } from '../lib/images';
import Layout from '../layouts/Layout.astro';
import CtaAlloVoisins from '../components/CtaAlloVoisins.astro';
import RatingBadge from '../components/RatingBadge.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import { site, serviceGroups, cities, whyUs, process } from '../data/site';
import { faq } from '../data/faq';

const heroImage = '/images/hero/chantier-maison-eragny.jpg';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title="YB Couverture — Couvreur dans le Val d'Oise"
  description="Couvreur à Éragny : rénovation de toiture, démoussage, gouttières, charpente et urgence fuite dans le Val d'Oise. Devis gratuit, intervention rapide."
  jsonLd={faqJsonLd}
  heroFlush
>
  <section class="hero">
    {/* La photo est un vrai <img> plutôt qu'un background CSS : elle peut ainsi
        être préchargée, déclinée en WebP et servie en version allégée sur
        mobile. Le voile sombre par-dessus garantit la lisibilité du texte
        quelle que soit la zone de l'image (le ciel est très clair). */}
    <div class="hero__media" aria-hidden="true">
      <picture>
        <source
          media="(max-width: 760px)"
          srcset="/images/hero/chantier-maison-eragny-760.webp"
          type="image/webp"
        />
        <source
          media="(max-width: 760px)"
          srcset="/images/hero/chantier-maison-eragny-760.jpg"
        />
        {webpSrc(heroImage) && <source srcset={webpSrc(heroImage)} type="image/webp" />}
        <img src={heroImage} alt="" loading="eager" fetchpriority="high" decoding="async" />
      </picture>
    </div>

    <div class="hero__inner container">
      <span class="eyebrow">Artisan Couvreur · {site.baseCity} & Val d'Oise</span>
      <h1>Votre toiture entre <br class="br-wide" />des mains expertes.</h1>
      <p class="lead">
        De l'intervention d'urgence à la rénovation complète, {site.name} protège votre habitat avec la
        précision d'un artisan local. Devis gratuit, disponibilité 24h/24 et 7j/7.
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="/contact/">
          Demander un devis gratuit
        </a>
        <a class="btn btn--ghost" href="/zone-intervention/">Voir la zone d'intervention</a>
      </div>
      <div class="hero-rating">
        <RatingBadge />
      </div>
      <div class="hero-stats">
        <div>
          <p class="stat-number">545+</p>
          <p class="stat-label">demandes traitées</p>
        </div>
        <div>
          <p class="stat-number">24/7</p>
          <p class="stat-label">disponibilité</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section container about">
    <div class="about-text">
      <p class="eyebrow">À propos</p>
      <h2 style="margin-top: 1rem;">Un artisan, pas un intermédiaire</h2>
      <p class="muted">{site.about}</p>
    </div>
  </section>

  <section class="section container" id="pourquoi">
    <div class="section-header">
      <h2 class="gradient-text">Pourquoi nous choisir.</h2>
      <p>Un artisan local, présent du premier appel à la dernière tuile.</p>
    </div>
    <div class="bento-grid why-grid">
      {whyUs.map((reason, i) => (
        <div class="bento-card">
          <div class="card-icon">{i + 1}</div>
          <h3>{reason.title}</h3>
          <p>{reason.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <div class="section-header">
      <h2 class="gradient-text">Notre expertise.</h2>
      <p>Interventions maîtrisées sur tous types de couvertures.</p>
    </div>
    <div class="bento-grid">
      {serviceGroups.map((group) => (
        <a class="bento-card service-card" href={`/${group.slug}/`}>
          <picture>
            {webpSrc(group.heroImage) && <source srcset={webpSrc(group.heroImage)} type="image/webp" />}
            <img class="service-card__thumb" src={group.heroImage} alt={group.title} loading="lazy" decoding="async" />
          </picture>
          <p class="tag">{group.shortTitle}</p>
          <h3>{group.title}</h3>
          <p>{group.summary}</p>
          <span class="service-card__link">En savoir plus →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section container">
    <div class="section-header">
      <h2 class="gradient-text">Comment ça se passe.</h2>
      <p>Du premier contact à la fin du chantier, en quatre étapes.</p>
    </div>
    <div class="process-grid">
      {process.map((step, i) => (
        <div class="card process-step">
          <div class="card-icon">{i + 1}</div>
          <h3>{step.title}</h3>
          <p class="muted">{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container" id="avis">
    <div class="section-header">
      <h2 class="gradient-text">Ce qu'en disent nos clients.</h2>
      <p>Avis réels laissés sur le profil AlloVoisins de YB Couverture.</p>
    </div>
    <Testimonials />
  </section>

  <section class="section container zone-preview">
    <div>
      <p class="eyebrow">Zone d'intervention</p>
      <h2 style="margin-top: 1rem;">Val d'Oise et communes voisines</h2>
      <p class="muted" style="margin: 1rem 0 1.5rem;">
        Basé à {site.baseCity}, {site.name} se déplace dans tout le Val d'Oise ainsi que dans plusieurs
        communes des environs.
      </p>
      <a class="btn btn--ghost" href="/zone-intervention/">Voir toutes les villes</a>
    </div>
    <ul class="city-pills">
      {cities.slice(0, 8).map((city) => (
        <li>{city}</li>
      ))}
    </ul>
  </section>

  <section class="section container" id="faq">
    <div class="section-header">
      <h2 class="gradient-text">Questions fréquentes.</h2>
      <p>Tout ce qu'on nous demande le plus souvent.</p>
    </div>
    <Faq />
  </section>

  <section class="section container">
    <CtaAlloVoisins showPhone />
  </section>
</Layout>

<style>
  /* === Héros : photo en pleine largeur, contenu par-dessus === */
  .hero {
    position: relative;
    isolation: isolate;
    /* La borne basse (6,5rem) n'est pas un choix esthétique : le header est
       maintenant flottant, et à 360 px son bord inférieur tombe à 74 px
       (12 px d'offset + 62 px d'îlot). En dessous de ~6,5rem le surtitre
       passerait derrière lui. À 768 px le bord descend à 82 px, à partir de
       900 px à 86 px — 6,5rem couvre les trois. */
    padding-block: clamp(6.5rem, 12vw, 7rem) clamp(3rem, 9vw, 5rem);
    text-align: center;
    /* Teinte de repli tant que la photo n'est pas chargée : le texte clair
       reste lisible même sur une connexion lente. */
    background: #131a26;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Cadrage sur la maison plutôt que sur la pelouse du premier plan. */
    object-position: 50% 38%;
  }

  /* Voile sombre. Dimensionné pour le pire cas : un texte blanc posé sur le
     pixel le plus clair de la photo (les nuages, du blanc pur). À 0,64
     d'opacité le rapport tombe à 5,6:1, au-delà du seuil AA de 4,5:1 — la
     lisibilité ne dépend donc jamais de la zone de l'image. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(13, 20, 33, 0.64) 0%,
      rgba(13, 20, 33, 0.7) 55%,
      rgba(13, 20, 33, 0.76) 100%
    );
  }

  .hero__inner {
    position: relative;
  }

  .hero h1 {
    max-width: 900px;
    margin: clamp(1.25rem, 4vw, 2rem) auto;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  /* Le surtitre est assombri, et non éclairci : une pastille claire
     remonterait le fond sous le texte blanc à 3,5:1. En sombre, le rapport
     monte à 8,3:1. */
  .hero .eyebrow {
    background: rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.3);
    color: #fff;
    backdrop-filter: blur(6px);
  }

  /* Le retour à la ligne manuel n'a de sens qu'à partir du moment
     où les deux membres de phrase tiennent sur une ligne */
  .br-wide {
    display: none;
  }

  @media (min-width: 700px) {
    .br-wide {
      display: inline;
    }
  }

  .hero .lead {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(255, 255, 255, 0.95);
    max-width: 750px;
    margin: 0 auto clamp(1.75rem, 5vw, 3rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .hero-rating {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(2rem, 6vw, 3rem);
  }

  /* La pastille d'avis est rendue par RatingBadge : ses styles sont scopés
     dans ce composant, il faut donc `:global` pour les adapter au fond sombre. */
  .hero-rating :global(.rating) {
    color: #fff;
  }

  .hero-rating :global(.muted) {
    color: rgba(255, 255, 255, 0.82);
  }

  .hero-rating :global(.stars) {
    /* L'or sombre choisi pour les fonds clairs tomberait à 1,8:1 ici. */
    color: #ffc94d;
  }

  .hero-rating :global(a.rating:hover) {
    background: rgba(255, 255, 255, 0.14);
  }

  .hero-stats {
    display: flex;
    gap: clamp(1.5rem, 8vw, 3.5rem);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: clamp(2.25rem, 6vw, 3.25rem);
    padding-top: clamp(1.5rem, 4vw, 2rem);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero-stats .stat-number {
    font-size: clamp(1.7rem, 6vw, 2.2rem);
    font-weight: 800;
    color: #fff;
    margin: 0;
    text-align: center;
    line-height: 1.2;
  }

  .hero-stats .stat-label {
    text-align: center;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.82);
    margin: 0.25rem 0 0;
  }

  .about {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .about-text {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .about-text .muted {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  /* « Pourquoi nous choisir » : les cartes n'ont pas de visuel, seulement
     une icône puis du texte. Le `margin-bottom: auto` de .card-icon plaque
     ce texte en bas de carte, si bien qu'un paragraphe plus long remonte
     son titre — les trois titres n'étaient pas sur la même ligne. */
  .why-grid .card-icon {
    margin-bottom: 0;
  }

  /* Le contenu repart du haut, ce qui suffit à aligner les icônes.
     La subgrid aligne en plus les titres et les paragraphes entre eux :
     chaque carte partage les rangées de la grille parente. */
  @supports (grid-template-rows: subgrid) {
    .why-grid {
      grid-auto-rows: auto;
    }

    .why-grid .bento-card {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 3;
      row-gap: 0;
    }
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-grid);
  }

  .process-step {
    padding: var(--card-pad-sm);
  }

  .process-step h3 {
    font-size: 1.05rem;
    margin: clamp(1rem, 3vw, 1.5rem) 0 0.6rem;
  }

  .process-step p {
    font-size: 0.9rem;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }

  .service-card {
    text-decoration: none;
  }

  .service-card__thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 18px;
    margin-bottom: 1.25rem;
  }

  .service-card__link {
    color: var(--accent-text);
    font-weight: 700;
    margin-top: auto;
    padding-top: 1rem;
  }

  .zone-preview {
    display: grid;
    gap: clamp(1.75rem, 5vw, 2.5rem);
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  @media (max-width: 780px) {
    .zone-preview {
      grid-template-columns: 1fr;
    }
  }
</style>

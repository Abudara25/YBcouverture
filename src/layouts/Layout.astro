---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, cities, cityZones, socials } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description, jsonLd, image = '/images/hero/banniere-toiture.jpg', noindex = false, breadcrumbs } = Astro.props;
const ogImageURL = new URL(image, Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// Zones desservies : départements (AdministrativeArea) + communes (City) pour un maillage local riche
const areaServed = [
  ...cityZones.map((z) => ({
    '@type': 'AdministrativeArea',
    name: `${z.department} (${z.code})`,
  })),
  ...cities.map((c) => ({ '@type': 'City', name: c })),
];

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RoofingContractor',
  '@id': `${siteURL}/#business`,
  name: site.name,
  legalName: `${site.name} — ${site.owner}`,
  description: site.description,
  image: ogImageURL.toString(),
  logo: `${siteURL}/images/logo-mark.png`,
  url: siteURL,
  telephone: site.phone,
  email: site.email,
  priceRange: site.priceRange,
  foundingDate: site.foundingDate,
  areaServed,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.streetAddress,
    addressLocality: `${site.baseCity}-sur-Oise`,
    postalCode: site.basePostalCode,
    addressRegion: site.region,
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.latitude,
    longitude: site.longitude,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: site.openTime,
    closes: site.closeTime,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.rating,
    reviewCount: site.reviewCount,
    bestRating: 5,
    worstRating: 1,
  },
  sameAs: [site.alloVoisinsUrl, ...socials.map((s) => s.url)],
};

const breadcrumbLd = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteURL}/` },
        ...breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: b.name,
          item: `${siteURL}${b.path}`,
        })),
      ],
    }
  : null;

const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = [defaultJsonLd, ...(breadcrumbLd ? [breadcrumbLd] : []), ...extra];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="geo.placename" content={`${site.baseCity}, Val d'Oise`} />
    <meta name="theme-color" content="#faf6f1" />

    <script is:inline>
      document.documentElement.classList.add('js');
      // Applique le thème sauvegardé avant le rendu (évite tout flash de couleur)
      try {
        var t = localStorage.getItem('yb-theme');
        if (t === 'ambre' || t === 'bleu') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>

    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <div class="ambient-glow-1"></div>
    <div class="ambient-glow-2"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <a class="mobile-call-bar" href={site.phoneHref}>
      📞 Appeler {site.phone}
    </a>

    <div class="theme-switch" role="group" aria-label="Choix de la couleur du site">
      <span class="theme-switch__label">Thème</span>
      <button type="button" data-theme-value="terracotta" title="Terracotta" aria-label="Thème terracotta"></button>
      <button type="button" data-theme-value="ambre" title="Ambré" aria-label="Thème ambré"></button>
      <button type="button" data-theme-value="bleu" title="Bleu & blanc" aria-label="Thème bleu et blanc"></button>
    </div>

    <script>
      (function () {
        const root = document.documentElement;
        const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-switch button');
        const alt = ['ambre', 'bleu'];
        function apply(theme: string) {
          if (alt.includes(theme)) root.setAttribute('data-theme', theme);
          else root.removeAttribute('data-theme');
          try {
            localStorage.setItem('yb-theme', theme);
          } catch (e) {}
          buttons.forEach((b) =>
            b.setAttribute('aria-pressed', String(b.dataset.themeValue === theme))
          );
        }
        let current = 'terracotta';
        try {
          const saved = localStorage.getItem('yb-theme');
          if (saved && alt.includes(saved)) current = saved;
        } catch (e) {}
        apply(current);
        buttons.forEach((b) =>
          b.addEventListener('click', () => apply(b.dataset.themeValue || 'terracotta'))
        );
      })();
    </script>

    <script>
      const sections = Array.from(document.querySelectorAll('main section'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        sections.forEach((s) => s.classList.add('is-visible'));
      } else {
        const reveal = (s: Element) => s.classList.add('is-visible');

        // Révèle toute section déjà dans le viewport OU au-dessus (cas des ancres profondes /#avis)
        const revealAbove = () => {
          sections.forEach((s) => {
            if (!s.classList.contains('is-visible') && s.getBoundingClientRect().top < window.innerHeight) {
              reveal(s);
            }
          });
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                reveal(entry.target);
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0, rootMargin: '0px 0px -8% 0px' }
        );
        sections.forEach((s) => observer.observe(s));

        revealAbove();
        window.addEventListener('load', revealAbove);
        window.addEventListener('hashchange', revealAbove);
        setTimeout(revealAbove, 400);
      }
    </script>
  </body>
</html>

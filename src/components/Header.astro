---
import { site, serviceGroups } from '../data/site';
---

<header class="site-header">
  <div class="nav-island">
    <a href="/" class="logo">
      <img src="/images/logo-mark.png" alt={site.name} width="221" height="300" />
      {site.name}
    </a>
    <nav class="nav-links" aria-label="Navigation principale">
      <div class="nav__dropdown">
        <span>Nos métiers</span>
        <ul>
          {serviceGroups.map((group) => (
            <li><a href={`/${group.slug}/`}>{group.shortTitle}</a></li>
          ))}
        </ul>
      </div>
      <a href="/zone-intervention/">Zone d'intervention</a>
      <a href="/actualites/">Actualités</a>
      <a href="/#avis">Avis</a>
      <a href="/contact/">Contact</a>
    </nav>
    <a class="btn-nav" href="/contact/">
      Devis gratuit
    </a>
    <button class="burger" id="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Ouvrir le menu">
      <span class="burger__bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-menu" aria-label="Navigation mobile">
    {serviceGroups.map((group) => (
      <a href={`/${group.slug}/`}>{group.shortTitle}</a>
    ))}
    <a href="/zone-intervention/">Zone d'intervention</a>
    <a href="/actualites/">Actualités</a>
    <a href="/#avis">Avis</a>
    <a href="/contact/">Contact</a>
    <a href="/contact/">Devis gratuit</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  if (toggle && mobileNav) {
    const setOpen = (open: boolean) => {
      mobileNav.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      document.body.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => setOpen(!mobileNav.classList.contains('open')));

    // Referme après une navigation, un clic à l'extérieur ou la touche Échap
    mobileNav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (
        mobileNav.classList.contains('open') &&
        !mobileNav.contains(target) &&
        !toggle.contains(target)
      ) {
        setOpen(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileNav.classList.contains('open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Sécurité : en repassant en desktop, on rétablit un état propre
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    --header-x: 12px;
    position: sticky;
    top: 12px;
    left: 0;
    right: 0;
    z-index: 200;
    padding: 0 var(--header-x);
    display: flex;
    justify-content: center;
  }

  .nav-island {
    width: 100%;
    max-width: 1100px;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: var(--radius-btn);
    padding: 8px 8px 8px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    box-shadow: var(--shadow-md);
    position: relative;
  }

  .logo {
    font-size: clamp(0.9rem, 3.4vw, 1rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--text-main);
    text-decoration: none;
    white-space: nowrap;
  }

  .logo img {
    height: clamp(38px, 11vw, 52px);
    width: auto;
    flex-shrink: 0;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-main);
    flex: 1;
  }

  .nav-links a {
    text-decoration: none;
    transition: var(--transition);
  }

  .nav-links a:hover {
    color: var(--text-main);
  }

  .nav__dropdown {
    position: relative;
    cursor: pointer;
  }

  .nav__dropdown > span:hover {
    color: var(--text-main);
  }

  .nav__dropdown::before {
    content: '';
    position: absolute;
    top: 100%;
    left: -1rem;
    right: -1rem;
    height: 1rem;
  }

  .nav__dropdown ul {
    display: none;
    position: absolute;
    top: 100%;
    left: -1rem;
    margin-top: 1rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 0.5rem;
    list-style: none;
    min-width: 220px;
    box-shadow: var(--shadow-lg);
  }

  .nav__dropdown:hover ul,
  .nav__dropdown:focus-within ul {
    display: block;
  }

  .nav__dropdown li a {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: 12px;
    color: var(--text-main);
  }

  .nav__dropdown li a:hover {
    background: rgba(var(--accent-rgb), 0.08);
    color: var(--accent-text);
  }

  .btn-nav {
    display: none;
    background: var(--text-main);
    color: #fff;
    padding: 0.65rem 1.3rem;
    border-radius: var(--radius-btn);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: var(--transition);
  }

  .btn-nav:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    background: #000;
  }

  .burger {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    padding: 0;
    flex-shrink: 0;
    border-radius: 50%;
    transition: var(--transition);
  }

  .burger:hover {
    background: rgba(var(--accent-rgb), 0.08);
  }

  .burger__bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 20px;
  }

  .burger span span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text-main);
    border-radius: 2px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .burger[aria-expanded='true'] span span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .burger[aria-expanded='true'] span span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: calc(100% + 8px);
    left: var(--header-x, 12px);
    right: var(--header-x, 12px);
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    transform: translateY(-10px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease,
      visibility 0.25s;
    box-shadow: var(--shadow-lg);
  }

  .mobile-menu.open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0.85rem 1.35rem;
    color: var(--text-main);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--glass-border);
  }

  .mobile-menu a:active {
    background: rgba(var(--accent-rgb), 0.06);
  }

  .mobile-menu a:last-child {
    color: var(--accent-text);
    font-weight: 700;
    border-bottom: none;
  }

  /* Desktop : navigation complète, plus de burger ni de menu déroulant */
  @media (min-width: 900px) {
    .site-header {
      --header-x: 16px;
      top: 16px;
    }

    .nav-island {
      justify-content: flex-start;
      gap: 2rem;
      padding: 8px 10px 8px 22px;
    }

    .nav-links {
      display: flex;
    }

    .btn-nav {
      display: inline-block;
    }

    .burger,
    .mobile-menu {
      display: none;
    }
  }
</style>

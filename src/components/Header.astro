---
import { site, serviceGroups } from '../data/site';
---

<header class="site-header">
  <div class="nav-island">
    <a href="/" class="logo">
      <img src="/images/logo-mark.png" alt={site.name} />
      {site.name}
    </a>
    <nav class="nav-links" aria-label="Navigation principale">
      <div class="nav__dropdown">
        <span>Nos métiers</span>
        <ul>
          {serviceGroups.map((group) => (
            <li><a href={`/${group.slug}/`}>{group.shortTitle}</a></li>
          ))}
        </ul>
      </div>
      <a href="/zone-intervention/">Zone d'intervention</a>
      <a href="/actualites/">Actualités</a>
      <a href="/#avis">Avis</a>
      <a href="/contact/">Contact</a>
    </nav>
    <a class="btn-nav" href="/contact/">
      Devis gratuit
    </a>
    <button class="burger" id="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Ouvrir le menu">
      <span></span><span></span>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-menu" aria-label="Navigation mobile">
    {serviceGroups.map((group) => (
      <a href={`/${group.slug}/`}>{group.shortTitle}</a>
    ))}
    <a href="/zone-intervention/">Zone d'intervention</a>
    <a href="/actualites/">Actualités</a>
    <a href="/#avis">Avis</a>
    <a href="/contact/">Contact</a>
    <a href="/contact/">Devis gratuit</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 16px;
    left: 0;
    right: 0;
    z-index: 200;
    padding: 0 16px;
    display: flex;
    justify-content: center;
  }

  .nav-island {
    width: 100%;
    max-width: 1100px;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: var(--radius-btn);
    padding: 8px 10px 8px 22px;
    display: flex;
    align-items: center;
    gap: 2rem;
    box-shadow: var(--shadow-md);
    position: relative;
  }

  .logo {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-main);
    text-decoration: none;
    white-space: nowrap;
  }

  .logo img {
    height: 52px;
    width: auto;
    flex-shrink: 0;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    flex: 1;
  }

  .nav-links a {
    text-decoration: none;
    transition: var(--transition);
  }

  .nav-links a:hover {
    color: var(--text-main);
  }

  .nav__dropdown {
    position: relative;
    cursor: pointer;
  }

  .nav__dropdown > span:hover {
    color: var(--text-main);
  }

  .nav__dropdown::before {
    content: '';
    position: absolute;
    top: 100%;
    left: -1rem;
    right: -1rem;
    height: 1rem;
  }

  .nav__dropdown ul {
    display: none;
    position: absolute;
    top: 100%;
    left: -1rem;
    margin-top: 1rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 0.5rem;
    list-style: none;
    min-width: 220px;
    box-shadow: var(--shadow-lg);
  }

  .nav__dropdown:hover ul,
  .nav__dropdown:focus-within ul {
    display: block;
  }

  .nav__dropdown li a {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: 12px;
    color: var(--text-main);
  }

  .nav__dropdown li a:hover {
    background: rgba(var(--accent-rgb), 0.08);
    color: var(--accent);
  }

  .btn-nav {
    background: var(--text-main);
    color: #fff;
    padding: 0.65rem 1.3rem;
    border-radius: var(--radius-btn);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition);
  }

  .btn-nav:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    background: #000;
  }

  .burger {
    display: flex;
    background: none;
    border: none;
    cursor: pointer;
    width: 40px;
    height: 40px;
    padding: 10px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
  }

  .burger span {
    display: block;
    height: 2px;
    background: var(--text-main);
    border-radius: 2px;
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: calc(100% + 8px);
    left: 16px;
    right: 16px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    transform: translateY(-10px);
    opacity: 0;
    pointer-events: none;
    transition: var(--transition);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .mobile-menu.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu a {
    display: block;
    padding: 1rem 1.5rem;
    color: var(--text-main);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--glass-border);
  }

  .mobile-menu a:last-child {
    color: var(--accent);
    font-weight: 600;
    border-bottom: none;
  }

  @media (min-width: 900px) {
    .nav-links {
      display: flex;
    }

    .burger {
      display: none;
    }

    .mobile-menu {
      display: none !important;
    }
  }
</style>
